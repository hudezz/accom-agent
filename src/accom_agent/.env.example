# LLM as "provider:model", e.g. openai:gpt-5-mini or ollama:qwen3.5:0.8b
MODEL_NAME=openai:gpt-5-mini

# Only needed for OpenAI models
OPENAI_API_KEY=
# Optional: leave empty to use free DuckDuckGo search instead of Tavily
TAVILY_API_KEY=
# Optional: only needed if geocoding switches to Google Maps
GOOGLE_MAPS_API_KEY=
# Max results per web search
MAX_SEARCH_RESULTS=10
